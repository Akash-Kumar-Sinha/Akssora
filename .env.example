# ==============================================================================
# Akssora Global Configuration Template (.env.example)
# Copy to .env and adjust paths for your system
# ==============================================================================

# Hypervisor & Guest Artifacts
FIRECRACKER_BIN=/usr/local/bin/firecracker
AKSSORA_KERNEL_PATH=/var/lib/akssora/images/vmlinux
AKSSORA_ROOTFS_PATH=/var/lib/akssora/images/rootfs.ext4
AKSSORA_GUEST_AGENT_PATH=/usr/local/bin/akssora-guest-agent

# REST API Gateway
PORT=3000
HOST=0.0.0.0
AKSSORA_API_KEY=dev-key
AKSSORA_BASE_URL=http://localhost:3000

# Client SDK & CLI Defaults
AKSSORA_API_URL=http://localhost:3000

# Security & Secrets Store
TUNNEL_SECRET=akssora-tunnel-secret-key-32-chars-long
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Scheduler Configuration
SCHEDULER_PORT=4000
